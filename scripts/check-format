#!/bin/bash
# Report clang-format violations without changing any files, then print a
# summary line.
#
# usage: check-format [--no-echo] [clang-format-option ...] file ...
#
# --no-echo prints only the summary line, not the clang-format output.

set -uo pipefail

echo_output=true
clang_format_args=()
for arg in "$@"; do
    if [ "$arg" = --no-echo ]; then
        echo_output=false
    else
        clang_format_args+=("$arg")
    fi
done

# clang-format reports violations on stderr; fd 3 keeps its stdout out of the
# capture.
exec 3>&1
output=$(xcrun clang-format --dry-run ${clang_format_args[@]+"${clang_format_args[@]}"} 2>&1 >&3)
status=$?
exec 3>&-

violations=$(printf '%s\n' "$output" \
    | grep -E ':[0-9]+:[0-9]+: (warning|error): .*\[-Wclang-format-violations\]$')

# Without violations there is no summary line to explain a failure, so the
# clang-format output is shown even with --no-echo.
if [ -z "$violations" ] && [ $status -ne 0 ]; then
    echo_output=true
fi

if $echo_output && [ -n "$output" ]; then
    printf '%s\n' "$output" >&2
fi

if [ -z "$violations" ]; then
    # A failure without violations is a clang-format error, such as a bad
    # option or a missing file, so nothing was actually checked.
    if [ $status -eq 0 ]; then
        echo "no format violations"
    fi
else
    violation_count=$(printf '%s\n' "$violations" | wc -l | tr -d ' ')
    file_count=$(printf '%s\n' "$violations" \
        | sed -E 's/:[0-9]+:[0-9]+: (warning|error): .*//' \
        | sort -u | wc -l | tr -d ' ')
    echo "$violation_count format violations in $file_count files"
fi

exit $status
